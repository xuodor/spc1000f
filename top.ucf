NET "clk_50" LOC = T8 | TNM_NET = sys_clk_pin;
TIMESPEC TS_sys_clk_pin = PERIOD sys_clk_pin 50000 kHz;

NET "reset_n"   LOC = L3 | IOSTANDARD = LVCMOS33;

# VGA Sync Signals
NET "vga_hs"    LOC = M14 | IOSTANDARD = LVCMOS33;
NET "vga_vs"    LOC = L13 | IOSTANDARD = LVCMOS33;

NET "vga_r<0>"               LOC = M11 | IOSTANDARD = LVCMOS33;        ## VGA R0
NET "vga_r<1>"               LOC = M12 | IOSTANDARD = LVCMOS33;        ## VGA R1
NET "vga_r<2>"               LOC = L12 | IOSTANDARD = LVCMOS33;        ## VGA R2
NET "vga_r<3>"               LOC = N14 | IOSTANDARD = LVCMOS33;        ## VGA R3
NET "vga_r<4>"               LOC = M13 | IOSTANDARD = LVCMOS33;        ## VGA R4
NET "vga_g<0>"               LOC = M9 | IOSTANDARD = LVCMOS33;         ## VGA G0
NET "vga_g<1>"               LOC = N9 | IOSTANDARD = LVCMOS33;         ## VGA G1
NET "vga_g<2>"               LOC = P9 | IOSTANDARD = LVCMOS33;         ## VGA G2
NET "vga_g<3>"               LOC = L10 | IOSTANDARD = LVCMOS33;        ## VGA G3
NET "vga_g<4>"               LOC = M10 | IOSTANDARD = LVCMOS33;        ## VGA G4
NET "vga_g<5>"               LOC = P11 | IOSTANDARD = LVCMOS33;        ## VGA G4
NET "vga_b<0>"               LOC = P7 | IOSTANDARD = LVCMOS33;         ## VGA B0
NET "vga_b<1>"               LOC = M7 | IOSTANDARD = LVCMOS33;         ## VGA B1
NET "vga_b<2>"               LOC = P8 | IOSTANDARD = LVCMOS33;         ## VGA B2
NET "vga_b<3>"               LOC = N8 | IOSTANDARD = LVCMOS33;         ## VGA B3
NET "vga_b<4>"               LOC = L7 | IOSTANDARD = LVCMOS33;         ## VGA B4

NET "usbdm"             LOC = B5 | IOSTANDARD = LVCMOS33;         ## USB D-
NET "usbdp"             LOC = A4 | IOSTANDARD = LVCMOS33;         ## USB D+

NET "seg_data<0>"            LOC = C7 | IOSTANDARD = LVCMOS33;  ##
NET "seg_data<1>"            LOC = E6 | IOSTANDARD = LVCMOS33;  ##
NET "seg_data<2>"            LOC = C5 | IOSTANDARD = LVCMOS33;  ##
NET "seg_data<3>"            LOC = F7 | IOSTANDARD = LVCMOS33;  ##
NET "seg_data<4>"            LOC = D6 | IOSTANDARD = LVCMOS33;  ##
NET "seg_data<5>"            LOC = E7 | IOSTANDARD = LVCMOS33;  ##
NET "seg_data<6>"            LOC = D5 | IOSTANDARD = LVCMOS33;  ##
NET "seg_data<7>"            LOC = C6 | IOSTANDARD = LVCMOS33;  ##

NET "scan_sig<5>"            LOC = D9 | IOSTANDARD = LVCMOS33;  ##
NET "scan_sig<4>"            LOC = E10 | IOSTANDARD = LVCMOS33;  ##
NET "scan_sig<3>"            LOC = F10 | IOSTANDARD = LVCMOS33;  ##
NET "scan_sig<2>"            LOC = F9 | IOSTANDARD = LVCMOS33;  ##
NET "scan_sig<1>"            LOC = E8 | IOSTANDARD = LVCMOS33;  ##
NET "scan_sig<0>"            LOC = D8 | IOSTANDARD = LVCMOS33;  ##

NET i2s_lrck                                   LOC = H15 | IOSTANDARD = "LVCMOS33";
NET i2s_din                                    LOC = F16 | IOSTANDARD = "LVCMOS33";
NET i2s_bck                                    LOC = E16 | IOSTANDARD = "LVCMOS33";
NET i2s_sck                                    LOC = C10 | IOSTANDARD = LVCMOS33 | DRIVE = 12 | SLEW = SLOW | PULLDOWN;

NET sdram_clk                     LOC =  H4 | IOSTANDARD = "LVCMOS33";        ## SDRAM CLOCK
NET sdram_cke                     LOC =  H2 | IOSTANDARD = "LVCMOS33";        ## SDRAM CKE
NET sdram_cs_n                     LOC =  G1 | IOSTANDARD = "LVCMOS33";        ## SDRAM CS
NET sdram_we_n                    LOC =  E1 | IOSTANDARD = "LVCMOS33";        ## SDRAM NWE
NET sdram_cas_n                   LOC =  F2 | IOSTANDARD = "LVCMOS33";        ## SDRAM CAS
NET sdram_ras_n                   LOC =  F1 | IOSTANDARD = "LVCMOS33";        ## SDRAM RAS

NET sdram_dqm<0>                  LOC =  E2 | IOSTANDARD = "LVCMOS33";        ## SDRAM DQM0
NET sdram_dqm<1>                  LOC =  H1 | IOSTANDARD = "LVCMOS33";        ## SDRAM DQM1

NET sdram_ba<0>                   LOC =  G6 | IOSTANDARD = "LVCMOS33";        ## SDRAM BA0
NET sdram_ba<1>                   LOC =  J6 | IOSTANDARD = "LVCMOS33";        ## SDRAM BA1

NET sdram_addr<0>                 LOC =  J3 | IOSTANDARD = "LVCMOS33";        ## SDRAM ADDR0
NET sdram_addr<1>                 LOC =  J4 | IOSTANDARD = "LVCMOS33";        ## SDRAM ADDR1
NET sdram_addr<2>                 LOC =  K3 | IOSTANDARD = "LVCMOS33";        ## SDRAM ADDR2
NET sdram_addr<3>                 LOC =  K5 | IOSTANDARD = "LVCMOS33";        ## SDRAM ADDR3
NET sdram_addr<4>                 LOC =  P1 | IOSTANDARD = "LVCMOS33";        ## SDRAM ADDR4
NET sdram_addr<5>                 LOC =  N1 | IOSTANDARD = "LVCMOS33";        ## SDRAM ADDR5
NET sdram_addr<6>                 LOC =  M2 | IOSTANDARD = "LVCMOS33";        ## SDRAM ADDR6
NET sdram_addr<7>                 LOC =  M1 | IOSTANDARD = "LVCMOS33";        ## SDRAM ADDR7
NET sdram_addr<8>                 LOC =  L1 | IOSTANDARD = "LVCMOS33";        ## SDRAM ADDR8
NET sdram_addr<9>                 LOC =  K2 | IOSTANDARD = "LVCMOS33";        ## SDRAM ADDR9
NET sdram_addr<10>                LOC =  K6 | IOSTANDARD = "LVCMOS33";        ## SDRAM ADDR10
NET sdram_addr<11>                LOC =  K1 | IOSTANDARD = "LVCMOS33";        ## SDRAM ADDR11
NET sdram_addr<12>                LOC =  J1 | IOSTANDARD = "LVCMOS33";        ## SDRAM ADDR12

NET sdram_dq<0>                 LOC = A3 | IOSTANDARD = "LVCMOS33";        ## SDRAM DATA0
NET sdram_dq<1>                 LOC = B3 | IOSTANDARD = "LVCMOS33";        ## SDRAM DATA1
NET sdram_dq<2>                 LOC = A2 | IOSTANDARD = "LVCMOS33";        ## SDRAM DATA2
NET sdram_dq<3>                 LOC = B2 | IOSTANDARD = "LVCMOS33";        ## SDRAM DATA3
NET sdram_dq<4>                 LOC = B1 | IOSTANDARD = "LVCMOS33";        ## SDRAM DATA4
NET sdram_dq<5>                 LOC = C2 | IOSTANDARD = "LVCMOS33";        ## SDRAM DATA5
NET sdram_dq<6>                 LOC = C1 | IOSTANDARD = "LVCMOS33";        ## SDRAM DATA6
NET sdram_dq<7>                 LOC = D1 | IOSTANDARD = "LVCMOS33";        ## SDRAM DATA7
NET sdram_dq<8>                 LOC = H5 | IOSTANDARD = "LVCMOS33";        ## SDRAM DATA8
NET sdram_dq<9>                 LOC = G5 | IOSTANDARD = "LVCMOS33";        ## SDRAM DATA9
NET sdram_dq<10>                LOC = H3 | IOSTANDARD = "LVCMOS33";        ## SDRAM DATA10
NET sdram_dq<11>                LOC = F6 | IOSTANDARD = "LVCMOS33";        ## SDRAM DATA11
NET sdram_dq<12>                LOC = G3 | IOSTANDARD = "LVCMOS33";        ## SDRAM DATA12
NET sdram_dq<13>                LOC = F5 | IOSTANDARD = "LVCMOS33";        ## SDRAM DATA13
NET sdram_dq<14>                LOC = F3 | IOSTANDARD = "LVCMOS33";        ## SDRAM DATA14
NET sdram_dq<15>                LOC = F4 | IOSTANDARD = "LVCMOS33";        ## SDRAM DATA15
